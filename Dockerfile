FROM docker.io/oven/bun:latest AS builderWORKDIR /appENV NODE_ENV=productionCOPY bun.lock package.json ./RUN bun install --production --frozen-lockfile --ignore-scriptsCOPY src ./srcRUN mkdir -p .fnlb && chown -R 65532:65532 /appFROM docker.io/oven/bun:distrolessWORKDIR /appCOPY --from=builder --chown=65532:65532 /app /appUSER 65532:65532CMD ["src/index.js"]